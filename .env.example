# HydroPulse Environment Configuration
# Copy this file to .env and adjust variables as needed

# Django Core Settings
SECRET_KEY=hydropulse-insecure-dev-key-change-in-production-2026-sdg6
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# Default is SQLite for instant zero-setup development.
# To switch to MySQL (e.g. XAMPP, local MySQL, or cloud MySQL):
# Set DB_ENGINE=mysql and fill in the MySQL parameters below.
DB_ENGINE=sqlite
DB_NAME=hydropulse_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Timezone & Localization
TIME_ZONE=Asia/Manila
LANGUAGE_CODE=en-us

# Notification Settings
# Mock mode prints notifications to console and database log without external API calls
NOTIFICATION_MOCK_MODE=True

# Pluggable Email (SMTP) Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=HydroPulse System <noreply@hydropulse.local>

# Pluggable SMS Gateway Configuration (e.g., PhilSMS, Semaphore, Twilio)
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_NAME=HydroPulse
